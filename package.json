{
  "name": "@a2f0/dnbm",
  "version": "0.4.11",
  "description": "A dark drum and bass sequencer, mixer and player with a WebAssembly audio engine, ready to embed in a page",
  "license": "UNLICENSED",
  "homepage": "https://dnbm.a2f0.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/dnbm.git"
  },
  "keywords": [
    "drum and bass",
    "sequencer",
    "synthesizer",
    "webassembly",
    "audioworklet"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "lib/",
    "site/",
    "docs/package.md",
    "docs/song-format.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./build": {
      "types": "./lib/build.d.ts",
      "import": "./lib/build.js"
    },
    "./assets/*": "./site/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agents:check": "agent-tool skills check",
    "agents:sync": "agent-tool skills install --apply",
    "build": "bun scripts/build/build.ts",
    "build:engine": "bun scripts/build/build.ts --engine",
    "build:package": "bun scripts/build/buildPackage.ts",
    "check": "agent-tool run-group scripts/testing/check.json",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "wrangler deploy --dry-run",
    "dev": "bun scripts/dev/serve.ts",
    "engine:check": "cargo fmt --manifest-path packages/synth/engine/Cargo.toml --check && cargo clippy --manifest-path packages/synth/engine/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path packages/synth/engine/Cargo.toml",
    "fix": "biome check --write && cargo fmt --manifest-path packages/synth/engine/Cargo.toml && bun scripts/songs/format.ts fmt",
    "hooks:check": "agent-tool hooks check",
    "hooks:install": "agent-tool hooks install --apply",
    "lint": "biome ci",
    "lint:binary-files": "agent-tool checks binaries",
    "lint:branch-name": "agent-tool branch check",
    "lint:commit-message": "agent-tool commits check --message-file",
    "lint:commit-trust": "agent-tool commits check",
    "lint:scripts": "sh scripts/checks/lintScripts.sh",
    "prepack": "bun run build:package",
    "prepublishOnly": "bun run check",
    "release:plan": "agent-tool release plan package.json",
    "render": "bun scripts/songs/render.ts",
    "songs:check": "bun scripts/songs/format.ts check",
    "songs:fmt": "bun scripts/songs/format.ts fmt",
    "test": "bun run build:engine && bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.20",
    "@a2f0/ct-client": "0.1.5",
    "@a2f0/dnbm-synth": "workspace:*",
    "@biomejs/biome": "2.6.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
