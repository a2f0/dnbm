{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!packages/synth/engine/target",
      "!dist",
      "!lib",
      "!site",
      "!.agents",
      "!.claude/skills",
      "!**/*.dnbm.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // tsconfig's noPropertyAccessFromIndexSignature wants record["key"].
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 20 }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error", "info", "warn"] } },
        // Type-only imports count too: a type-only cycle still tangles the modules.
        "noImportCycles": { "level": "error", "options": { "ignoreTypes": false } }
      }
    }
  },
  // Layering (docs/architecture.md): synth is below both apps, the apps never import
  // each other, and the sequencer's panels see the editor through editor.ts, not app.ts.
  "overrides": [
    {
      "includes": ["packages/synth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/sequencer/**",
                      "**/player/**",
                      "@a2f0/dnbm-sequencer",
                      "@a2f0/dnbm-player"
                    ],
                    "message": "The synth is below both apps; it never imports them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/player/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/sequencer/**", "@a2f0/dnbm-sequencer"],
                    "message": "The apps never import each other; shared code belongs in packages/synth."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sequencer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/player/**", "@a2f0/dnbm-player"],
                    "message": "The apps never import each other; shared code belongs in packages/synth."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sequencer/src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app", "**/mount", "**/main"],
                    "message": "Panels see the editor through ../editor (the Editor interface), not app.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
