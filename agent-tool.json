{
  "schemaVersion": 1,
  "subject": {
    "conventional": true,
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "merge": {
    "requireChecks": true,
    "requiredChecks": [
      {
        "name": "CI gate",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": false
  },
  "versions": {
    "packages": ["."],
    "lockfile": "bun.lock",
    "validate": [],
    "commitMessage": "chore: bump package versions"
  },
  "pr": {
    "rejectClaudeBranding": true
  }
}
