{
  "schemaVersion": 1,
  "subject": {
    "conventional": true,
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "lowercaseInitial": true,
    "rejectTerminalPeriod": true,
    "ignoreGenerated": true
  },
  "merge": {
    "requireChecks": true,
    "requiredChecks": [
      {
        "name": "CI gate",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": false
  },
  "versions": {
    "packages": ["."],
    "lockfile": "bun.lock",
    "validate": [],
    "commitMessage": "chore: bump package versions"
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "enforce": true,
    "types": null,
    "exempt": ["main"],
    "maxLength": null
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": false,
    "rejectCoauthors": true,
    "rejectClaudeAttribution": false,
    "subjects": true
  },
  "binaries": {
    "allow": []
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  }
}
