{
  "schemaVersion": 1,
  "subject": {
    "conventional": true,
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ],
    "lowercaseInitial": true,
    "rejectTerminalPeriod": true,
    "ignoreGenerated": true
  },
  "merge": {
    "requireChecks": true,
    "requiredChecks": [
      {
        "name": "CI gate",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": false
  },
  "versions": {
    "packages": ["."],
    "lockfile": "bun.lock",
    "validate": [],
    "commitMessage": "chore: bump package versions"
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "enforce": true,
    "types": null,
    "exempt": ["main"],
    "maxLength": null
  },
  "commits": {
    "signatures": "present",
    "signatureHeaderFallback": false,
    "rejectCoauthors": true,
    "rejectClaudeAttribution": false,
    "subjects": true
  },
  "binaries": {
    "allow": []
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "logo" }] },
          { "path": "icon.svg", "layers": [{ "source": "logo" }] },
          { "path": "favicon.ico", "sizes": [16, 32, 48], "layers": [{ "source": "logo" }] },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [{ "fill": "#0a0a0a" }, { "source": "logo", "scale": 0.8 }]
          }
        ]
      }
    }
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-commit",
        "target": "pre-commit",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  }
}
