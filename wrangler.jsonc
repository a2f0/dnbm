{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dnbm",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  // Assets-only Worker: Cloudflare serves dist/ (bun run build) directly.
  // Terraform in a2f0/a2f0.net owns the custom domain (dnbm.a2f0.net).
  // Unknown paths answer 404 with dist/404.html, which only the production build has.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
