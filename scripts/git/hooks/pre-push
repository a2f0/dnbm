#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run bun run hooks:install." >&2
  exit 1
fi

cd "$REPO_ROOT"

bun run --silent hooks:check </dev/null

push_remote=${1:-origin}
zero_sha="0000000000000000000000000000000000000000"

refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT
trap 'exit 1' HUP INT TERM

if [ -t 0 ]; then
  : >"$refs_file"
else
  cat >"$refs_file"
fi

step() {
  echo ""
  echo "==> $1"
}

empty_tree=$(git hash-object -t tree /dev/null)

# The commit a pushed ref's new work starts from: the remote's old tip, origin/main
# for a new branch, or nothing for the first push to an empty repository.
push_base() {
  if [ "$1" != "$zero_sha" ]; then
    printf '%s\n' "$1"
  elif git rev-parse --verify --quiet origin/main >/dev/null; then
    printf '%s\n' origin/main
  fi
}

# Runs a check once per pushed ref. With --commits it gets the commits the ref adds
# (all of them, for a first push); with --changes, the range of trees to diff.
for_each_pushed_range() {
  kind=$1
  shift
  while read -r _ local_sha _ remote_sha; do
    if [ "$local_sha" = "$zero_sha" ]; then
      continue
    fi

    base=$(push_base "$remote_sha")
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    elif [ "$kind" = --commits ]; then
      range="$local_sha"
    else
      range="$empty_tree..$local_sha"
    fi

    if [ "$kind" = --commits ] && git remote get-url "$push_remote" >/dev/null 2>&1; then
      "$@" --range "$range" --exclude-remotes "$push_remote" </dev/null
    else
      "$@" --range "$range" </dev/null
    fi
  done <"$refs_file"
}

step "Linting branch name"
bun run --silent lint:branch-name --pre-push <"$refs_file"

step "Checking commit signatures and co-authors"
for_each_pushed_range --commits bun run --silent lint:commit-trust

step "Checking for binary files"
for_each_pushed_range --changes bun run --silent lint:binary-files

bun run --silent check
